# Neon Postgres connection string (Vercel adds this when you connect a Neon database)
DATABASE_URL=
# Shared passcode the two of you type to sign in
APP_PASSCODE=
# Random string, at least 16 characters, used to sign the login cookie
SESSION_SECRET=
# Comma-separated names of the people using the tracker
MEMBERS=Quzzy,Friend
# Vercel sends this as a Bearer token to the daily cron job
CRON_SECRET=
# Optional: company job boards the finder scans
GREENHOUSE_BOARDS=stripe,datadog,cloudflare,gitlab,mongodb,elastic,airbnb,dropbox,twilio,hubspot,databricks,figma,coinbase,samsara,intercom
LEVER_COMPANIES=palantir,spotify,plaid,wealthsimple
